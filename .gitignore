# =========================
# Content
# Large media should not be stored in Git
# =========================
content/media/*
!content/media/.gitkeep

content/releases/*
!content/releases/.gitkeep

# =========================
# Environment files
# =========================
.env
.env.*
!.env.example

# =========================
# OS / editor
# =========================
.DS_Store
.vscode/
.idea/