# =========================
# Python / backend
# =========================
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

backend/.env

# =========================
# Node / admin
# =========================
node_modules/
admin/dist/
admin/.env

# =========================
# Flutter / mobile
# =========================
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
