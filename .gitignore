# Python / backend
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
backend/.env

# Node / admin
node_modules/
admin/dist/
admin/tsconfig.tsbuildinfo
admin/.env

# Flutter / mobile
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/android/local.properties
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/build/
*.iml
*.apk
*.aab
# Signing material: never commit, anywhere in the repo
key.properties
*.jks
*.keystore

# Content (large binaries) — real media should live in object storage,
# not git, once past local dev
content/media/*
!content/media/.gitkeep
content/releases/*
!content/releases/.gitkeep
content/videos/*
!content/videos/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# Local backup copies
*.bak
*.bak2
mobile/android/.before-id-backup/

# Env files in general
.env
.env.*
!.env.example
