<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: Forest Green behind the (unchanged) launcher icon.
     Colours from values/brand_colors.xml, generated from brand/tokens.json. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_primary</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_white</item>
    </style>
</resources>
