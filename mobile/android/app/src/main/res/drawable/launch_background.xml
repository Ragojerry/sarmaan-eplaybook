<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while Flutter initializes, before SplashScreen (lib/screens/splash_screen.dart) takes over:
     the same Forest Green to deep forest gradient, top to bottom. Colours from values/brand_colors.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/brand_forest_green"
                android:endColor="@color/brand_deep_forest" />
        </shape>
    </item>
</layer-list>
