ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://sarmaan:sarmaan@db:5432/sarmaan_eplaybook

JWT_SECRET_KEY=change-me-generate-a-real-secret
# Generate a real one with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=../content/media
