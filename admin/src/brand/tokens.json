    "titleSmall":   {"size": 16, "weight": 700, "lineHeight": 1.3},
    "body":         {"size": 13, "weight": 400, "lineHeight": 1.55},
    "bodySmall":    {"size": 11.5, "weight": 400, "lineHeight": 1.5},
    "label":        {"size": 10.5, "weight": 700, "lineHeight": 1.3, "letterSpacing": 1.2},
