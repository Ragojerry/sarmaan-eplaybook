{
  "_about": "The one design-token file for the app and the admin portal (IHS Towers Brand Manual, Aug 2021, v1.01). Edit here, then run: python scripts/brand_sync.py. Tints are the colour mixed with white at the given percentage, as in the guide.",
  "palette": {
    "forestGreen": "#002D14",
    "white": "#FFFFFF",
    "red": "#F04E43",
    "grassGreen": "#008732",
    "lightGrey": "#D0D0CE",
    "midGrey": "#A7A8AA",
    "darkGrey": "#494546",
    "teal": "#05B39C",
    "orange": "#F47B22",
    "blue": "#0888CA"
  },
  "tints": {
    "forestGreen40": ["forestGreen", 40],
    "forestGreen10": ["forestGreen", 10],
    "grassGreen50": ["grassGreen", 50],
    "grassGreen10": ["grassGreen", 10],
    "teal60": ["teal", 60],
    "orange60": ["orange", 60],
    "orange15": ["orange", 15],
    "blue50": ["blue", 50],
    "blue10": ["blue", 10],
    "red10": ["red", 10],
    "lightGrey20": ["lightGrey", 20],
    "darkGrey80": ["darkGrey", 80]
  },
  "_tints_note": "In the guide: forestGreen40, grassGreen50, teal60, orange60, blue50, lightGrey20. Derived (not listed in the guide, same mixing rule, used only as backgrounds or for contrast): forestGreen10, grassGreen10, orange15, blue10, red10, darkGrey80.",
  "semantic": {
    "primary": "forestGreen",
    "onPrimary": "white",
    "background": "white",
    "surface": "white",
    "surfaceMuted": "lightGrey20",
    "surfaceSelected": "forestGreen10",
    "divider": "lightGrey",
    "controlBorder": "darkGrey80",
    "text": "darkGrey",
    "textStrong": "forestGreen",
    "textMuted": "darkGrey80",
    "textDisabled": "midGrey",
    "textOnPrimary": "white",
    "success": "grassGreen",
    "successText": "grassGreen",
    "successSurface": "grassGreen10",
    "warning": "orange",
    "warningText": "forestGreen",
    "warningSurface": "orange15",
    "error": "red",
    "errorText": "forestGreen",
    "errorSurface": "red10",
    "info": "blue",
    "infoText": "forestGreen",
    "infoSurface": "blue10",
    "progressTrack": "lightGrey",
    "progressFill": "grassGreen",
    "highlight": "teal",
    "highlightSurface": "teal60"
  },
  "_semantic_note": "Red, Orange, Blue and Teal fail 4.5:1 as text on white, so they are fills, icons and borders only; the text next to them uses the *Text token. See docs/brand/contrast_report.md.",
  "font": {
    "family": "Helvetica Neue",
    "fallback": ["Helvetica", "Arial", "Roboto", "Noto Sans", "sans-serif"],
